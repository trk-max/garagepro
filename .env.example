# PostgreSQL (Supabase: Connect → ORM → Prisma)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js + signature des sessions client — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Adresse publique du site (liens envoyés aux clients), ex. https://garagepro-beta.vercel.app
# OBLIGATOIRE en production (Vercel, npm run serve) : jamais déduite des en-têtes de la requête.
APP_URL=""

# ── Optionnel : envoi automatique SMS (Twilio) ──
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── E-mails automatiques (Resend — https://resend.com, 3 000 e-mails/mois gratuits) ──
# Clé : Resend → API Keys → Create API Key (commence par re_)
RESEND_API_KEY=""
# Avant vérification d'un domaine : "Garage <onboarding@resend.dev>" (envoie UNIQUEMENT à l'e-mail de votre compte Resend)
# Après vérification (Resend → Domains) : "Garage Atlas <rdv@votredomaine.tn>"
SUPPORT_FROM_EMAIL="Garage <onboarding@resend.dev>"
# Facultatif : adresse qui reçoit les réponses des clients
RESEND_REPLY_TO=""

# ── E-mails avec votre Gmail (gratuit, SANS domaine, ~500 e-mails/jour) ──
# Utilisé automatiquement si Resend n'est pas configuré ou échoue.
# SMTP_PASS = « mot de passe d'application » Google (PAS le mot de passe normal) :
# compte Google → Sécurité → Validation en 2 étapes (activée) → Mots de passe des applications
SMTP_USER=""
SMTP_PASS=""
# Facultatif : nom affiché (ex. "911 Garages"), autre serveur que Gmail
SMTP_FROM_NAME=""
SMTP_HOST=""
SMTP_PORT=""

# ── Optionnel : photos/vidéos dans Supabase Storage (sinon dossier ./storage) ──
SUPABASE_STORAGE_BUCKET=""
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Assistant auto IA (portail client /assistant) ──
# Le guide à choix fonctionne toujours, sans clé. Les clés ci-dessous activent l'IA
# pour les questions libres. Toutes gratuites. Plusieurs clés par fournisseur :
# séparez-les par des virgules. Si une clé est vide, épuisée ou en panne, l'assistant
# passe automatiquement à la clé suivante, puis au fournisseur suivant.
# Gemini : https://aistudio.google.com → Get API key
GEMINI_API_KEY=""
# Groq : https://console.groq.com → API Keys
GROQ_API_KEY=""
# Cerebras : https://cloud.cerebras.ai → API Keys
CEREBRAS_API_KEY=""
# Mistral : https://console.mistral.ai → API Keys (offre Experiment)
MISTRAL_API_KEY=""
# OpenRouter : https://openrouter.ai → Keys. Modèle OBLIGATOIRE, dont le nom finit par ":free"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Facultatif : ordre d'essai (par défaut gemini,groq,cerebras,mistral,openrouter,custom)
AI_PROVIDERS=""
# Facultatif : changer de modèle, ex. GROQ_MODEL="openai/gpt-oss-20b"
GEMINI_MODEL=""
GROQ_MODEL=""

# Facultatif : votre propre serveur compatible OpenAI (ex. Ollama sur votre PC : http://localhost:11434/v1 et qwen3:8b)
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# Adresse IP des visiteurs (limites anti-abus) : nombre de proxys de confiance devant l'application.
# Vercel : ignoré (l'IP fournie par Vercel est utilisée). PC du garage accessible directement : 0.
TRUSTED_PROXY_HOPS=1

# ── Mode hors ligne : « hub » sur le PC du garage (voir README, « Mode hors ligne ») ──
# Sur le PC du garage UNIQUEMENT :
#   DATABASE_URL et DIRECT_URL = la base PostgreSQL LOCALE, ex.
#   "postgresql://postgres:MOTDEPASSE@localhost:5432/garagepro"
#   SUPABASE_STORAGE_BUCKET="" (vide : les photos restent sur le PC puis sont envoyées en ligne)
GARAGE_HUB_LOCAL=""
# Base en ligne (Supabase → Connect → « Session pooler », port 5432) :
CLOUD_DATABASE_URL=""
# Facultatif : certificat SSL Supabase (Database Settings → SSL Configuration → Download)
CLOUD_DATABASE_CA_FILE=""
# Nom du bucket Supabase des photos (avec NEXT_PUBLIC_SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY ci-dessus)
CLOUD_STORAGE_BUCKET=""
# Secondes entre deux synchronisations (défaut 30)
SYNC_INTERVAL_SECONDS=""
# Sur Vercel UNIQUEMENT (quand un hub existe) : GARAGE_HUB="1"
# → factures, bons de commande et de réception numérotés seulement au garage (pas de doublons).
GARAGE_HUB=""

# ── Rappels clients automatiques (Prompt 2/5) ────────────────────────────────
# Secret partagé entre le planificateur (Vercel Cron, ou le hub du garage chaque heure)
# et l'application. 16 caractères minimum, différent de AUTH_SECRET.
# Vercel : Settings → Environment Variables → CRON_SECRET (même valeur que sur le PC du garage).
CRON_SECRET=""

# ── Sauvegardes automatiques (PC du garage, Prompt 2/5) ──────────────────────
# 1) Créez la clé de chiffrement UNE fois : npm run backup:key
#    (fichier hors du projet ; gardez-en une copie ailleurs : sans elle, rien n'est relisible).
# 2) Le hub sauvegarde chaque jour à BACKUP_HOUR ; « npm run backup » pour le faire à la main.
# BACKUP_DIR=""          # défaut : <dossier utilisateur>\GaragePro\backups
# BACKUP_COPY_DIR=""     # 2e emplacement : clé USB, OneDrive, NAS… (fortement conseillé)
# BACKUP_KEY_FILE=""     # défaut : <dossier utilisateur>\GaragePro\backup.key
# BACKUP_KEEP="14"       # nombre de versions conservées dans chaque dossier
# BACKUP_HOUR="23"
# BACKUP_SOURCE_URL=""   # défaut : DATABASE_URL
# BACKUP_RESTORE_TEST_URL=""  # serveur où tester la restauration (défaut : PostgreSQL local, base "postgres")
# PG_BIN=""              # dossier de pg_dump.exe si non trouvé automatiquement

# Notifications sur le téléphone (Web Push) : npx web-push generate-vapid-keys — vide = désactivé.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
