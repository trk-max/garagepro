# PostgreSQL (Supabase: Connect → ORM → Prisma)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js + signature des sessions client — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Adresse publique du site (liens envoyés aux clients). Vide = détectée automatiquement.
APP_URL=""

# ── Optionnel : envoi automatique SMS (Twilio) ──
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ── E-mails automatiques (Resend — https://resend.com, 3 000 e-mails/mois gratuits) ──
# Clé : Resend → API Keys → Create API Key (commence par re_)
RESEND_API_KEY=""
# Avant vérification d'un domaine : "Garage <onboarding@resend.dev>" (envoie UNIQUEMENT à l'e-mail de votre compte Resend)
# Après vérification (Resend → Domains) : "Garage Atlas <rdv@votredomaine.tn>"
SUPPORT_FROM_EMAIL="Garage <onboarding@resend.dev>"
# Facultatif : adresse qui reçoit les réponses des clients
RESEND_REPLY_TO=""

# ── Optionnel : photos/vidéos dans Supabase Storage (sinon dossier ./storage) ──
SUPABASE_STORAGE_BUCKET=""
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Assistant auto IA (portail client /assistant) ──
# Le guide à choix fonctionne toujours, sans clé. Les clés ci-dessous activent l'IA
# pour les questions libres. Toutes gratuites. Plusieurs clés par fournisseur :
# séparez-les par des virgules. Si une clé est vide, épuisée ou en panne, l'assistant
# passe automatiquement à la clé suivante, puis au fournisseur suivant.
# Gemini : https://aistudio.google.com → Get API key
GEMINI_API_KEY=""
# Groq : https://console.groq.com → API Keys
GROQ_API_KEY=""
# Cerebras : https://cloud.cerebras.ai → API Keys
CEREBRAS_API_KEY=""
# Mistral : https://console.mistral.ai → API Keys (offre Experiment)
MISTRAL_API_KEY=""
# OpenRouter : https://openrouter.ai → Keys. Modèle OBLIGATOIRE, dont le nom finit par ":free"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Facultatif : ordre d'essai (par défaut gemini,groq,cerebras,mistral,openrouter,custom)
AI_PROVIDERS=""
# Facultatif : changer de modèle, ex. GROQ_MODEL="openai/gpt-oss-20b"
GEMINI_MODEL=""
GROQ_MODEL=""

# Facultatif : votre propre serveur compatible OpenAI (ex. Ollama sur votre PC : http://localhost:11434/v1 et qwen3:8b)
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""
