{
  "name": "garagepro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "precheck": "node -e \"require('fs').rmSync('.next/types',{recursive:true,force:true})\"",
    "check": "tsc --noEmit && eslint . && vitest run",
    "doctor": "node scripts/doctor.mjs",
    "dev:lan": "next dev --turbopack -H 0.0.0.0",
    "predev:lan": "prisma generate",
    "serve": "node scripts/serve.mjs",
    "preserve": "prisma generate",
    "lint": "eslint .",
    "reset-access": "node --env-file=.env scripts/reset-access.mjs",
    "hub:init": "node --env-file=.env scripts/hub/init.mjs",
    "hub": "node --env-file=.env scripts/hub/start.mjs",
    "prehub": "node scripts/hub/prehub.mjs",
    "hub:sync": "node --env-file=.env scripts/hub/run-sync.mjs --once",
    "test:hub": "vitest run tests/hub-sync.test.ts",
    "test:db": "node scripts/test-db-client.mjs && vitest run --config vitest.db.config.ts",
    "db:cloud": "node --env-file=.env scripts/hub/migrate-cloud.mjs",
    "backup": "node --env-file=.env scripts/backup/run.mjs",
    "backup:key": "node --env-file-if-exists=.env scripts/backup/tools.mjs key",
    "backup:verify": "node --env-file=.env scripts/backup/tools.mjs verify",
    "backup:restore": "node --env-file=.env scripts/backup/tools.mjs restore",
    "shortcut": "node --env-file-if-exists=.env scripts/make-shortcut.mjs",
    "installer": "node scripts/installer/build.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@prisma/adapter-pg": "^6.19.3",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "nodemailer": "$nodemailer"
  }
}
