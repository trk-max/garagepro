// ─────────────────────────────────────────────────────────────────────────────
// GaragePro — gestion d'atelier mécanique (ordres de réparation, stock, factures)
// PostgreSQL + Prisma 6. Montants stockés en millimes (1 DT = 1000 millimes).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  // One SQL query (JOINs) per findMany/include instead of one per relation:
  // with a remote database (Supabase) each round trip costs ~50-150 ms.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  /// Responsable d'atelier : valide congés, corrections de pointage, contrôle qualité.
  MANAGER
  RECEPTION
  MECHANIC
  STOREKEEPER // magasinier
  // ── Showroom (V9) ──
  /// Vendeur : crée ses annonces et ne gère que les siennes (et leurs conversations).
  SELLER
  /// Responsable showroom : gère toutes les annonces et toutes les conversations du showroom.
  SHOWROOM_MANAGER
  /// Ressources humaines : équipe, congés, attestations, contrats de travail (V9).
  HR
  /// Comptable : factures, factures fournisseurs, prévision de trésorerie en lecture (V9).
  ACCOUNTANT
}

enum WorkOrderStatus {
  RECEIVED // véhicule réceptionné
  DIAGNOSIS // diagnostic en cours
  QUOTE_SENT // devis envoyé, en attente d'accord client
  WAITING_INSURANCE // en attente de l'accord de l'assurance
  WAITING_PARTS // en attente de pièces
  IN_PROGRESS // réparation en cours
  QUALITY_CONTROL // contrôle qualité & essai routier
  WASHING // nettoyage / lavage
  READY // prêt, client prévenu
  DELIVERED // rendu au client (final)
  CANCELLED // annulé (final, pièces remises en stock)
}

enum Priority {
  LOW
  NORMAL
  URGENT
}

enum LineType {
  LABOR
  PART
}

enum FuelType {
  ESSENCE
  DIESEL
  HYBRID
  ELECTRIC
  GPL
}

enum StockMovementReason {
  PURCHASE
  WORK_ORDER
  WORK_ORDER_RETURN
  ADJUSTMENT
  GOODS_RECEIPT
  SUPPLIER_RETURN // pièce renvoyée au fournisseur (défectueuse, erreur de livraison)
  CORRECTION // annule un mouvement manuel erroné (lié par correctsId)
}

enum PurchaseOrderStatus {
  PENDING_APPROVAL // demande du magasinier, en attente de l'admin
  APPROVED // validé : bon de commande envoyable au fournisseur
  PARTIAL // partiellement reçu
  RECEIVED // entièrement reçu
  REJECTED
  CANCELLED
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ReminderChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum InvoiceStatus {
  ISSUED
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  CHECK
  TRANSFER
}

enum EventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  LINE_ADDED
  LINE_REMOVED
  PACKAGE_APPLIED
  NOTE
  INVOICED
  PAYMENT
  QUOTE_APPROVED // validé par le client depuis le portail
  CUSTOMER_MESSAGE // message envoyé depuis le portail
  MEDIA_ADDED
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN // véhicule réceptionné → ordre de réparation créé
  CANCELLED
  NO_SHOW
}

// ── Staff (login) ────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  role            Role      @default(MECHANIC)
  phone           String?
  passwordHash    String
  isActive        Boolean   @default(true)
  lastSeenAt      DateTime?
  /// Fiche RH (attestations, rapports) — facultatif.
  jobTitle        String?
  hireDate        DateTime? @db.Date
  /// N° CIN, uniquement pour les attestations de travail.
  nationalId      String?
  /// Jours de congé payé par an (année civile, du 1er janvier au 31 décembre). null = non défini.
  annualLeaveDays Int?
  /// Type de contrat (attestation de travail) : "CDI", "CDD", "SIVP" ou "OTHER". null = non renseigné.
  contractType    String?
  /// Coût horaire de l'employé pour le garage (millimes / heure). null = coût horaire du garage.
  hourlyCost      Int?
  /// V10.3 — tableau de bord personnalisé : [{ id, visible }] dans l’ordre. null = disposition par défaut.
  dashboardLayout Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clockEvents             ClockEvent[]      @relation("ClockUser")
  employmentContracts     Contract[]        @relation("ContractEmployee")
  leaveRequests           LeaveRequest[]    @relation("LeaveUser")
  decidedLeaves           LeaveRequest[]    @relation("LeaveDecidedBy")
  laborEntries            LaborEntry[]      @relation("LaborUser")
  certificates            WorkCertificate[] @relation("CertificateUser")
  assignedWorkOrders      WorkOrder[]       @relation("Mechanic")
  createdWorkOrders       WorkOrder[]       @relation("CreatedBy")
  events                  WorkOrderEvent[]
  payments                Payment[]
  stockMovements          StockMovement[]
  requestedPurchaseOrders PurchaseOrder[]   @relation("PoRequestedBy")
  approvedPurchaseOrders  PurchaseOrder[]   @relation("PoApprovedBy")
  goodsReceipts           GoodsReceipt[]
  supplierPayments        SupplierPayment[]
  reminders               InvoiceReminder[]
  uploadedMedia           WorkOrderMedia[]
  appointments            Appointment[]
  handledClaims           CustomerClaim[]
  permissionOverrides     UserPermission[]  @relation("PermUser")
  grantedPermissions      UserPermission[]  @relation("PermGrantedBy")
  /// V14 — carte des compétences.
  supervisedWorkOrders    WorkOrder[]          @relation("Supervisor")
  skills                  EmployeeSkill[]
  skillHistory            SkillLevelHistory[]
  skillCertificates       SkillCertificate[]
  skillGoals              SkillGoal[]
  skillReviews            SkillReviewRequest[]
}

/// V10.3 — accès sur mesure : exception par employé à la matrice des rôles (src/lib/permissions.ts).
/// Règle : DENY > GRANT > rôle. Une seule ligne par (employé, permission).
model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("PermUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Nom de la permission (clé de MATRIX).
  permission  String
  /// "GRANT" ou "DENY".
  effect      String
  grantedById String?
  grantedBy   User?    @relation("PermGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([userId, permission])
}

// ── Clients & véhicules ──────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String
  email          String?
  address        String?
  /// Matricule fiscal pour les clients professionnels (facturation).
  taxId          String?
  /// N° de CIN (ou passeport) du client particulier (ordre de réparation, facture). V10.6.
  nationalId     String?
  notes          String?
  /// Client professionnel (flotte) : peut avoir des comptes sur le portail entreprise.
  isCompany      Boolean  @default(false)
  /// Le client refuse les rappels d'entretien (SMS / e-mail). Les messages de service
  /// (RDV, voiture prête, livraison prévue) restent envoyés.
  reminderOptOut Boolean  @default(false)
  /// Client favori (V10, tableau de bord) : épinglé dans l'onglet « Favoris ».
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyUsers CompanyUser[]
  contracts    Contract[]
  vehicles     Vehicle[]
  workOrders   WorkOrder[]
  invoices     Invoice[]
  appointments Appointment[]
  claims       CustomerClaim[]
  feedbacks    CustomerFeedback[]
  warranties   Warranty[]

  @@index([phone])
  @@index([name])
}

model Vehicle {
  id         String    @id @default(cuid())
  /// Immatriculation normalisée, ex. "123 TU 4567" → "123TU4567".
  plate      String    @unique
  make       String
  model      String
  year       Int?
  vin        String?
  fuel       FuelType?
  color      String?
  mileage    Int?
  customerId String
  /// Jeton secret du QR Code du véhicule (lien /v/<jeton>). null = pas de QR ou révoqué.
  /// Renouveler = nouveau jeton : l'ancienne étiquette ne fonctionne plus.
  qrToken    String?   @unique
  qrIssuedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contracts    ContractVehicle[]
  workOrders   WorkOrder[]
  appointments Appointment[]
  maintenance  VehicleMaintenance[]
  readings     VehicleReading[]
  warranties   Warranty[]
  /// V12 — agenda des prochaines réparations.
  agendaEvents    MaintenanceEvent[]
  agendaForecasts MaintenanceForecast[]

  @@index([customerId])
}

// ── Ordres de réparation ─────────────────────────────────────────────────────

model WorkOrder {
  id                   String          @id @default(cuid())
  /// Affiché "OR-0042".
  number               Int             @unique @default(autoincrement())
  status               WorkOrderStatus @default(RECEIVED)
  priority             Priority        @default(NORMAL)
  /// Ce que le client signale.
  complaint            String
  /// Constat du mécanicien.
  diagnosis            String?
  mileageIn            Int?
  customerId           String
  vehicleId            String
  mechanicId           String?
  createdById          String?
  /// Heure de fin estimée (ETA) affichée au client.
  promisedAt           DateTime?
  quoteApprovedAt      DateTime?
  /// Code à 4 chiffres remis au client pour le suivi en ligne (avec l'immatriculation).
  trackingPin          String?
  readyAt              DateTime?
  deliveredAt          DateTime?
  /// Assurance (dossier sinistre).
  insurerName          String?
  insuranceClaimRef    String?
  insuranceRequestedAt DateTime?
  insuranceDecidedAt   DateTime?
  /// APPROVED | REJECTED | PARTIAL (null = pas de décision).
  insuranceDecision    String?
  /// Prise en charge (V10.6) : niveau de carburant à l'arrivée en quarts (1 = 1/4 … 4 = 4/4).
  fuelLevel            Int?
  /// État de la carrosserie à l'arrivée : constat libre (rayures, chocs…).
  bodyDamageNotes      String?
  /// Zones abîmées cochées à l'arrivée, ex. ["FRONT_BUMPER", "LEFT_SIDE"] (src/lib/repair-order.ts).
  bodyChecklist        Json            @default("[]")
  /// Origine des pièces acceptée par le client : ORIGINE | ADAPTABLE | OCCASION | FOURNIES_CLIENT.
  partsOrigin          String?
  /// Montant estimatif TTC saisi à l'accueil (millimes), utilisé tant qu'il n'y a pas de lignes.
  estimateTtc          Int?
  /// Acompte reçu à la prise en charge (millimes) et son mode (CASH, CARD…) : à reporter en paiement sur la facture.
  depositAmount        Int?
  depositMethod        String?
  /// V14 — superviseur (employé AUTONOME qui encadre un SUPERVISÉ) ; ses heures restent les siennes (chronos).
  supervisorId         String?
  /// V14 — compétences requises choisies à la main (ids de Skill). null = déduites des forfaits / lignes.
  skillIds             Json?
  /// V14 — avertissements de la dernière affectation [{ code, skillId?, userId? }] et leur traitement.
  skillWarnings        Json            @default("[]")
  skillWarningsAt      DateTime?
  skillWarningsAckAt   DateTime?
  skillWarningsAckById String?
  /// V14 — dérogation explicite d'un responsable à la règle « habilitation exigée » (motif, journalisée).
  skillOverrideReason  String?
  skillOverrideById    String?
  skillOverrideAt      DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  supervisor     User?               @relation("Supervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle        Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  mechanic       User?               @relation("Mechanic", fields: [mechanicId], references: [id], onDelete: SetNull)
  createdBy      User?               @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contracts      Contract[]
  lines          WorkOrderLine[]
  events         WorkOrderEvent[]
  invoice        Invoice?
  stockMovements StockMovement[]
  media          WorkOrderMedia[]
  appointment    Appointment?
  claims         CustomerClaim[]
  feedback       CustomerFeedback?
  laborEntries   LaborEntry[]
  partNeeds      WorkOrderPartNeed[]
  expenses       WorkOrderExpense[]
  reservations   StockReservation[]
  readings       VehicleReading[]
  qualityCheck   QualityCheck?
  warranties     Warranty[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([mechanicId, status])
  @@index([vehicleId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([supervisorId])
}

model WorkOrderLine {
  id           String   @id @default(cuid())
  workOrderId  String
  type         LineType
  description  String
  /// Quantité × 100 (ex. 150 = 1,5 h ou 1,5 L).
  quantityX100 Int
  unitPrice    Int // millimes HT
  /// Taux TVA en points de base (1900 = 19 %).
  taxRateBp    Int      @default(1900)
  partId       String?
  /// Coût d'achat HT unitaire de la pièce au moment où elle est utilisée (millimes).
  /// null = inconnu (lignes antérieures à la V7.3, ou pièce saisie à la main) → coût estimé / incomplet.
  unitCost     Int?
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([workOrderId, position])
}

model WorkOrderEvent {
  id          String    @id @default(cuid())
  workOrderId String
  actorId     String?
  type        EventType
  /// Texte libre pour NOTE ; sinon données { from, to, … }.
  body        String?
  data        Json      @default("{}")
  createdAt   DateTime  @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
}

// ── Stock ────────────────────────────────────────────────────────────────────

model Part {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  brand        String?
  /// Stock en quantité × 100.
  stockX100    Int      @default(0)
  minStockX100 Int      @default(0)
  /// Quantité réservée pour des réparations (× 100) : disponible = stock − réservé.
  reservedX100 Int      @default(0)
  costPrice    Int      @default(0) // millimes HT
  salePrice    Int // millimes HT
  unit         String   @default("pce")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines             WorkOrderLine[]
  movements         StockMovement[]
  packageLines      PackageLine[]
  purchaseLines     PurchaseOrderLine[]
  receiptLines      GoodsReceiptLine[]
  partNeeds         WorkOrderPartNeed[]
  reservations      StockReservation[]
  warranties        Warranty[]
  defaultSupplierId String?
  defaultSupplier   Supplier?           @relation(fields: [defaultSupplierId], references: [id], onDelete: SetNull)

  @@index([name])
}

model StockMovement {
  id          String              @id @default(cuid())
  partId      String
  /// + entrée, − sortie (quantité × 100).
  deltaX100   Int
  reason      StockMovementReason
  workOrderId String?
  receiptId   String?
  /// Retour fournisseur : à qui la pièce est renvoyée.
  supplierId  String?
  /// Correction : le mouvement manuel qu'elle annule (une seule correction par mouvement).
  correctsId  String?             @unique
  actorId     String?
  note        String?
  createdAt   DateTime            @default(now())

  part        Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  receipt     GoodsReceipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  supplier    Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  corrects    StockMovement? @relation("StockCorrection", fields: [correctsId], references: [id], onDelete: SetNull)
  correctedBy StockMovement? @relation("StockCorrection")
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([partId, createdAt(sort: Desc)])
  @@index([workOrderId])
}

// ── Forfaits (ex. vidange, freinage) ─────────────────────────────────────────

model ServicePackage {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines PackageLine[]
}

model PackageLine {
  id           String   @id @default(cuid())
  packageId    String
  type         LineType
  description  String
  quantityX100 Int
  /// Null pour une pièce = prix de vente actuel de la pièce.
  unitPrice    Int?
  partId       String?
  position     Int      @default(0)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  part    Part?          @relation(fields: [partId], references: [id], onDelete: SetNull)
}

// ── Facturation ──────────────────────────────────────────────────────────────

model Invoice {
  id          String        @id @default(cuid())
  /// "F2026-0001"
  number      String        @unique
  workOrderId String        @unique
  customerId  String
  status      InvoiceStatus @default(ISSUED)
  totalHt     Int
  totalTax    Int
  stampDuty   Int
  totalTtc    Int
  paidAmount  Int           @default(0)
  issuedAt    DateTime      @default(now())
  /// Échéance de paiement (null = à réception).
  dueDate     DateTime?
  /// Copie figée des lignes et de l'en-tête au moment de la facturation.
  snapshot    Json

  workOrder WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  customer  Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments  Payment[]
  reminders InvoiceReminder[]

  @@index([issuedAt(sort: Desc)])
  @@index([status, dueDate])
  @@index([customerId])
}

/// Relance client pour retard de paiement (historique).
model InvoiceReminder {
  id        String          @id @default(cuid())
  invoiceId String
  channel   ReminderChannel
  message   String
  actorId   String?
  sentAt    DateTime        @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([invoiceId, sentAt])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  amount    Int
  method    PaymentMethod
  reference String?
  /// Qui a payé : "CUSTOMER" (client) ou "INSURANCE" (assurance).
  payer     String        @default("CUSTOMER")
  actorId   String?
  paidAt    DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

/// Compteurs (numérotation des factures par année).
model Sequence {
  key   String @id
  value Int    @default(0)
}

/// Paramètres du garage (une seule ligne, id = "garage").
model Setting {
  id                     String   @id @default("garage")
  garageName             String   @default("Mon Garage")
  address                String?
  phone                  String?
  email                  String?
  taxId                  String?
  /// Taux horaire main d'œuvre, millimes HT.
  laborRate              Int      @default(35000)
  defaultTaxBp           Int      @default(1900)
  /// Droit de timbre par facture, millimes.
  stampDuty              Int      @default(1000)
  invoiceFooter          String?
  /// Logo des documents imprimés (data URL PNG/JPEG/WEBP, 300 Ko max). Vide = logo GaragePro.
  logoDataUrl            String?
  /// Adresse publique du site (liens SMS / e-mail, QR Codes) quand APP_URL n'est pas réglé, ex. https://garage.vercel.app
  siteUrl                String?
  /// Délai de paiement client en jours (échéance = date facture + délai).
  paymentTermsDays       Int      @default(15)
  /// Fuseau horaire du garage (créneaux de réservation).
  timezone               String   @default("Africa/Tunis")
  bookingEnabled         Boolean  @default(true)
  /// Pas entre deux créneaux proposés (minutes).
  bookingSlotMinutes     Int      @default(30)
  /// Nombre de véhicules pris en charge en parallèle (ponts / postes).
  bookingCapacity        Int      @default(3)
  /// Délai minimum avant un RDV (minutes).
  bookingLeadMinutes     Int      @default(120)
  /// Jusqu'à combien de jours à l'avance on peut réserver.
  bookingHorizonDays     Int      @default(30)
  /// Horaires par jour (0 = dimanche) : { "1": { "open": "08:00", "close": "17:00" }, "0": null }
  /// Raison sociale, représentant légal, ville (attestations de travail).
  legalName              String?
  legalRepName           String?
  legalRepTitle          String?
  /// Attestations : capital social (texte, ex. « 50 000 DT »), adresse du siège si différente
  /// de l'adresse du garage, n° et ville du registre (RNE / registre du commerce). Tous facultatifs.
  legalCapital           String?
  legalAddress           String?
  registryNumber         String?
  registryCity           String?
  city                   String?
  /// Pointage : "CODE" (code de la borne), "NETWORK" (réseau du garage) ou "CODE_AND_NETWORK".
  clockMode              String   @default("CODE")
  /// Réseaux autorisés pour le pointage, ex. "192.168.100.0/24, 41.226.10.5".
  clockNetworks          String?
  /// Facturation de la main-d'œuvre proposée à partir du temps passé :
  /// "ELAPSED" (temps de l'intervention, même si plusieurs mécaniciens) ou "PERSON" (somme des heures de chacun).
  laborBillingMode       String   @default("ELAPSED")
  /// Seuils de la page « Suivi & retards » (et du compteur du menu) :
  /// livraison promise dépassée depuis plus de N heures (0 = dès que l'heure est passée),
  /// pièce attendue en retard depuis plus de N jours, assurance sans réponse depuis plus de N jours.
  alertOrderLateHours    Int      @default(0)
  alertPartLateDays      Int      @default(0)
  alertInsuranceDays     Int      @default(3)
  /// Rentabilité : coût horaire moyen de la main-d'œuvre pour le garage (millimes / heure ; 0 = non renseigné).
  laborCostPerHour       Int      @default(0)
  /// Frais indirects : "NONE", "PERCENT_REVENUE" (overheadValue = points de base du CA HT)
  /// ou "PER_LABOR_HOUR" (overheadValue = millimes par heure-personne).
  overheadMode           String   @default("NONE")
  overheadValue          Int      @default(0)
  /// Garantie automatique des réparations à la livraison : N mois et/ou N km (0 = pas de garantie automatique).
  warrantyMonths         Int      @default(0)
  warrantyKm             Int      @default(0)
  /// Trésorerie : alerte si le solde prévu passe sous ce seuil dans les 90 jours (millimes ; 0 = pas d'alerte),
  /// selon le scénario "PRUDENT", "NORMAL" ou "OPTIMISTIC".
  cashAlertThreshold     Int      @default(0)
  cashAlertScenario      String   @default("PRUDENT")
  /// Rappels : envoyer N jours avant l'échéance d'entretien.
  reminderLeadDays       Int      @default(7)
  /// Alertes : réparation sans changement de statut depuis plus de N jours ;
  /// livraison promise dans moins de N heures alors que le véhicule n'est pas en fin de travaux.
  alertStuckDays         Int      @default(5)
  alertDeliveryRiskHours Int      @default(24)
  /// Contrats (V9) : alerte N jours avant la date de fin d'un contrat signé / actif.
  contractAlertDays      Int      @default(30)
  /// Tableau de bord (V10) : objectif d'encaissements du mois (millimes ; 0 = pas d'objectif).
  monthlyRevenueTarget   Int      @default(0)
  /// Ordre de réparation (V10.6) : articles [{ title, body }] imprimés sur la prise en charge (null = textes par défaut).
  /// Variables : {storageFee} {graceHours} {abandonDays}.
  repairClauses             Json?
  /// Frais de gardiennage par jour (millimes), franchise (heures) et délai d'abandon (jours).
  storageFeePerDay          Int       @default(20000)
  storageGraceHours         Int       @default(48)
  abandonmentDays           Int       @default(30)
  /// Un administrateur a enregistré que les clauses ont été validées par un juriste (qui / quand).
  /// Remis à null dès que les textes ou les montants changent.
  repairClausesReviewedAt   DateTime?
  repairClausesReviewedById String?
  /// Facture : conditions / modes de paiement imprimés, et pénalités de retard (imprimées seulement si saisies).
  invoicePaymentTerms       String?
  invoicePenaltyText        String?
  /// Modèles de message (null = texte par défaut). Variables : {garage} {plate} {item} {date} {km} {time} {phone}.
  tplMaintenance         String?
  tplAppointment         String?
  tplDelivery            String?
  /// V12 — agenda des prochaines réparations : nombre minimum de cas observés pour utiliser l'historique
  /// du garage (sinon intervalle de référence), nombre de cas pour une confiance « bonne »,
  /// délai d'avance des messages (jours), envoi automatique (désactivé par défaut) et confiance minimale exigée.
  agendaMinCases         Int      @default(5)
  agendaGoodCases        Int      @default(10)
  agendaLeadDays         Int      @default(30)
  agendaAutoSend         Boolean  @default(false)
  agendaAutoMinConfidence String  @default("MEDIUM")
  /// Modèles de message de l'agenda (null = texte par défaut). Variables : {garage} {plate} {item} {when} {price} {phone}.
  tplAgendaFr            String?
  tplAgendaAr            String?
  /// V14 — compétences : rappel N jours avant l'expiration d'un certificat ; le superviseur valide le point
  /// « travaux vérifiés » du contrôle qualité ; libellés publics sur le suivi client (désactivé par défaut).
  skillCertReminderDays   Int     @default(30)
  skillSupervisorVerifies Boolean @default(false)
  skillPublicLabels       Boolean @default(false)
  openingHours           Json     @default("{\"0\":null,\"1\":{\"open\":\"08:00\",\"close\":\"17:00\"},\"2\":{\"open\":\"08:00\",\"close\":\"17:00\"},\"3\":{\"open\":\"08:00\",\"close\":\"17:00\"},\"4\":{\"open\":\"08:00\",\"close\":\"17:00\"},\"5\":{\"open\":\"08:00\",\"close\":\"17:00\"},\"6\":{\"open\":\"08:00\",\"close\":\"13:00\"}}")
  updatedAt              DateTime @updatedAt
}

// ── Espace fournisseur ───────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  contact   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts          Part[]
  contracts      Contract[]
  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]
  invoices       SupplierInvoice[]
  partNeeds      WorkOrderPartNeed[]
  expenses       WorkOrderExpense[]
  stockMovements StockMovement[]
  warranties     Warranty[]
  fixedCosts     RecurringExpense[]

  @@index([name])
}

/// Bon de commande. Créé par le magasinier (PENDING_APPROVAL), validé par l'admin.
model PurchaseOrder {
  id              String              @id @default(cuid())
  /// "BC2026-0001"
  number          String              @unique
  supplierId      String
  status          PurchaseOrderStatus @default(PENDING_APPROVAL)
  notes           String?
  requestedById   String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  expectedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requestedBy User?               @relation("PoRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?               @relation("PoApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines       PurchaseOrderLine[]
  receipts    GoodsReceipt[]
  invoices    SupplierInvoice[]
  partNeeds   WorkOrderPartNeed[]

  @@index([status, createdAt(sort: Desc)])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  partId          String
  quantityX100    Int
  receivedX100    Int    @default(0)
  unitCost        Int // millimes HT
  position        Int    @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
}

/// Bon de réception : chaque ligne entre en stock.
model GoodsReceipt {
  id              String   @id @default(cuid())
  /// "BR2026-0001"
  number          String   @unique
  supplierId      String
  purchaseOrderId String?
  /// N° du bon de livraison fournisseur.
  deliveryNoteRef String?
  notes           String?
  receivedById    String?
  receivedAt      DateTime @default(now())

  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  receivedBy    User?              @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]
  movements     StockMovement[]

  @@index([receivedAt(sort: Desc)])
  @@index([supplierId])
}

model GoodsReceiptLine {
  id           String @id @default(cuid())
  receiptId    String
  partId       String
  quantityX100 Int
  unitCost     Int

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  part    Part         @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([receiptId])
}

/// Facture reçue d'un fournisseur (suivi des dettes).
model SupplierInvoice {
  id              String                @id @default(cuid())
  /// Numéro de la facture chez le fournisseur.
  number          String
  supplierId      String
  purchaseOrderId String?
  issuedAt        DateTime
  dueDate         DateTime?
  totalHt         Int
  totalTax        Int
  totalTtc        Int
  paidAmount      Int                   @default(0)
  status          SupplierInvoiceStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime              @default(now())

  supplier      Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  payments      SupplierPayment[]

  @@unique([supplierId, number])
  @@index([status, dueDate])
}

model SupplierPayment {
  id                String        @id @default(cuid())
  supplierInvoiceId String
  amount            Int
  method            PaymentMethod
  reference         String?
  actorId           String?
  paidAt            DateTime      @default(now())

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  actor           User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([supplierInvoiceId])
}

// ── Portail client ───────────────────────────────────────────────────────────

/// Photo / vidéo prise par le technicien (pièce remplacée, défaut constaté…).
model WorkOrderMedia {
  id                String    @id @default(cuid())
  workOrderId       String
  kind              MediaKind
  /// Chemin dans le stockage (disque local ou bucket Supabase).
  storageKey        String    @unique
  contentType       String
  size              Int
  caption           String?
  visibleToCustomer Boolean   @default(true)
  uploadedById      String?
  createdAt         DateTime  @default(now())

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
}

/// Journal des tentatives (connexion suivi, prise de RDV) pour bloquer les abus.
model PortalAttempt {
  id        String   @id @default(cuid())
  key       String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ── Prise de rendez-vous ─────────────────────────────────────────────────────

model BookableService {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  durationMin   Int
  /// Tarif indicatif "à partir de", millimes TTC.
  priceFrom     Int?
  icon          String   @default("wrench")
  position      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id                  String            @id @default(cuid())
  /// Référence communiquée au client, ex. "RDV-7KQ2MX".
  reference           String            @unique
  serviceId           String
  startAt             DateTime
  endAt               DateTime
  status              AppointmentStatus @default(CONFIRMED)
  firstName           String
  lastName            String
  phone               String
  email               String?
  plate               String
  make                String?
  model               String?
  notes               String?
  customerId          String?
  vehicleId           String?
  workOrderId         String?           @unique
  mechanicId          String?
  confirmationSentVia String?
  cancelledAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  service   BookableService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workOrder WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  mechanic  User?           @relation(fields: [mechanicId], references: [id], onDelete: SetNull)

  @@index([startAt, status])
  @@index([plate])
  @@index([customerId])
}

// ── Réclamations & avis clients ──────────────────────────────────────────────

enum ClaimCategory {
  QUALITY // travail mal fait / panne revenue
  DELAY // retard
  PRICE // prix / devis
  BILLING // facture
  DAMAGE // dommage sur le véhicule
  BEHAVIOR // accueil / comportement
  OTHER
}

enum ClaimStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// Réclamation déposée par un client depuis le site (espace client).
model CustomerClaim {
  id          String        @id @default(cuid())
  /// Affiché "REC-0012".
  number      Int           @unique @default(autoincrement())
  category    ClaimCategory @default(OTHER)
  status      ClaimStatus   @default(OPEN)
  name        String
  phone       String
  email       String?
  plate       String?
  message     String
  /// Réponse de l'équipe.
  response    String?
  workOrderId String?
  customerId  String?
  handledById String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  handledBy User?      @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// Avis du client après une réparation ou une visite (note de 1 à 5).
model CustomerFeedback {
  id          String   @id @default(cuid())
  rating      Int
  comment     String?
  name        String?
  plate       String?
  /// Une seule note par ordre de réparation.
  workOrderId String?  @unique
  customerId  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ── Mode garage (hors ligne) : journal de synchronisation ───────────────────
// Rempli par des triggers PostgreSQL (prisma/migrations/3_sync_log), lu par
// scripts/hub/sync.mjs. Déclaré ici pour que Prisma ne le considère pas comme
// une table inconnue.

model SyncLog {
  id    BigInt   @id @default(autoincrement())
  tbl   String
  rowId String   @map("row_id")
  op    String   @db.Char(1)
  at    DateTime @default(now()) @db.Timestamptz(3)

  @@index([tbl, rowId])
  @@map("_sync_log")
}

model SyncState {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("_sync_state")
}

// ── Équipe : journal, pointage, congés, attestations ─────────────────────────

/// Journal d'audit : qui a fait quoi, quand, avant / après. Lignes non modifiables
/// (protégées par un trigger SQL). Jamais de mot de passe ni de secret dedans.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  /// Nom de l'auteur au moment de l'action (reste lisible si le compte est supprimé).
  actorName String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

enum ClockKind {
  IN
  OUT
  BREAK_START
  BREAK_END
}

enum ClockMethod {
  /// Code affiché sur la borne du garage (change toutes les 30 s).
  KIOSK_CODE
  /// Appareil sur le réseau du garage.
  NETWORK
  /// Code de la borne ET réseau du garage.
  KIOSK_CODE_NETWORK
  /// Saisie / correction par un responsable (avec motif).
  CORRECTION
}

/// Pointage. Jamais modifié ni supprimé : une erreur est annulée (voidedAt + motif)
/// et remplacée par une ligne CORRECTION.
model ClockEvent {
  id          String      @id @default(cuid())
  userId      String
  kind        ClockKind
  at          DateTime
  method      ClockMethod
  ip          String?
  /// Fenêtre du code de borne utilisée (un code = un pointage par personne).
  codeWindow  Int?
  reason      String?
  createdById String?
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  createdAt   DateTime    @default(now())

  user User @relation("ClockUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, codeWindow])
  @@index([userId, at])
  @@index([at])
}

enum LeaveType {
  PAID_LEAVE // congé payé
  SICK // maladie
  UNPAID // congé sans solde
  AUTHORIZATION // autorisation (quelques heures)
  ABSENCE // absence déclarée
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  number       Int         @unique @default(autoincrement())
  userId       String
  type         LeaveType
  startAt      DateTime
  endAt        DateTime
  /// true = journées entières (startAt/endAt à minuit, fin exclue).
  allDay       Boolean     @default(true)
  reason       String?
  status       LeaveStatus @default(PENDING)
  createdById  String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user      User  @relation("LeaveUser", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy User? @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId, startAt])
  @@index([status, startAt])
  @@index([startAt, endAt])
}

/// Attestation de travail délivrée (copie figée des informations imprimées).
model WorkCertificate {
  id         String   @id @default(cuid())
  /// "ATT-2026-0001"
  number     String   @unique
  userId     String
  issuedById String?
  purpose    String?
  snapshot   Json
  issuedAt   DateTime @default(now())

  user User @relation("CertificateUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt])
}

// ── Atelier : temps passé, pièces manquantes, contrôle qualité ──────────────

/// Temps réellement passé par un mécanicien sur un ordre (plusieurs mécaniciens possibles).
/// Indépendant des lignes de main-d'œuvre facturées.
model LaborEntry {
  id          String    @id @default(cuid())
  workOrderId String
  userId      String
  startedAt   DateTime
  /// null = chronomètre en cours.
  endedAt     DateTime?
  note        String?
  createdById String?
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  user      User      @relation("LaborUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([workOrderId, startedAt])
  @@index([userId, startedAt])
}

enum PartNeedStatus {
  NEEDED // à commander
  ORDERED // commandée
  RECEIVED // reçue
  CANCELLED
}

/// Pièce qui manque pour terminer une réparation.
model WorkOrderPartNeed {
  id              String         @id @default(cuid())
  workOrderId     String
  partId          String?
  description     String
  quantityX100    Int            @default(100)
  status          PartNeedStatus @default(NEEDED)
  supplierId      String?
  purchaseOrderId String?
  orderedAt       DateTime?
  /// Date de livraison prévue.
  expectedAt      DateTime?
  receivedAt      DateTime?
  note            String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workOrder     WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part          Part?          @relation(fields: [partId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([status, expectedAt])
}

/// Contrôle qualité obligatoire avant « Prêt ».
model QualityCheck {
  id              String    @id @default(cuid())
  workOrderId     String    @unique
  /// "DONE" | "NOT_NEEDED" (null = pas encore renseigné).
  roadTest        String?
  fluidsOk        Boolean   @default(false)
  warningsOk      Boolean   @default(false)
  toolsRemoved    Boolean   @default(false)
  workVerified    Boolean   @default(false)
  billingVerified Boolean   @default(false)
  notes           String?
  checkedById     String?
  checkedAt       DateTime?
  /// Validation finale par un responsable (annulée si un point change ensuite).
  approvedById    String?
  approvedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

// ── Portail entreprise ───────────────────────────────────────────────────────

enum CompanyRole {
  /// Gère les comptes de son entreprise, voit tout (dont factures).
  FLEET_ADMIN
  /// Voit véhicules, réparations, devis et factures.
  MANAGER
  /// Voit véhicules et réparations, sans montants.
  VIEWER
}

/// Compte d'un employé d'une entreprise cliente : ne voit QUE les véhicules de son entreprise.
model CompanyUser {
  id           String      @id @default(cuid())
  customerId   String
  email        String      @unique
  name         String
  role         CompanyRole @default(VIEWER)
  passwordHash String
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
}

/// Dépense directement liée à une réparation (sous-traitance, location d'outil, remorquage…), HT.
/// Jamais effacée : une erreur est annulée (voidedAt + motif), visible dans l'historique.
model WorkOrderExpense {
  id          String    @id @default(cuid())
  workOrderId String
  description String
  /// Montant HT en millimes.
  amount      Int
  supplierId  String?
  createdById String?
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
}

/// Pièce mise de côté pour une réparation : elle reste en stock mais n'est plus disponible
/// pour une autre sortie. ACTIVE → CONSUMED (utilisée sur l'ordre) ou RELEASED (libérée).
model StockReservation {
  id           String    @id @default(cuid())
  partId       String
  workOrderId  String
  quantityX100 Int
  /// "ACTIVE", "CONSUMED" ou "RELEASED".
  status       String    @default("ACTIVE")
  createdById  String?
  createdAt    DateTime  @default(now())
  closedAt     DateTime?
  closedNote   String?

  part      Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([partId, status])
  @@index([workOrderId, status])
}

/// Plan d'entretien d'un véhicule : à refaire tous les N jours et/ou tous les N km.
model VehicleMaintenance {
  id           String    @id @default(cuid())
  vehicleId    String
  /// "OIL", "FILTERS", "SERVICE", "BRAKES", "TIRES", "BATTERY" ou "OTHER".
  kind         String
  label        String?
  intervalDays Int?
  intervalKm   Int?
  lastDoneAt   DateTime?
  lastDoneKm   Int?
  isActive     Boolean   @default(true)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
}

// ── Agenda des prochaines réparations (V12) ─────────────────────────────────

/// Élément d'entretien du catalogue du garage (vidange, plaquettes AV…). Reconnu dans les lignes
/// d'ordres livrés par une pièce liée, un forfait lié ou un mot-clé. L'intervalle de référence est
/// SAISI par le garage (null = pas de référence) : aucune valeur « constructeur » n'est inventée.
model MaintenanceItem {
  id             String   @id @default(cuid())
  /// Code stable, ex. "OIL", "PADS_FRONT" (catalogue de départ) ou "C-…" (élément ajouté).
  code           String   @unique
  nameFr         String
  nameAr         String?
  nameEn         String?
  /// Mots-clés recherchés dans la description des lignes (minuscules, sans accents).
  keywords       Json     @default("[]")
  /// Pièces (Part.id) et forfaits (ServicePackage.id) qui reconnaissent l'élément.
  partIds        Json     @default("[]")
  packageIds     Json     @default("[]")
  intervalKm     Int?
  intervalMonths Int?
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events    MaintenanceEvent[]
  forecasts MaintenanceForecast[]
}

/// Remplacement passé d'un élément sur un véhicule : détecté dans un ordre livré (source PART,
/// PACKAGE, KEYWORD) ou déclaré par le garage (MANUAL). Les données d'origine (doneAt, km) ne sont
/// jamais modifiées : une correction remplit corrected* / cancelled* (journalisée).
model MaintenanceEvent {
  id              String    @id @default(cuid())
  /// "wo:<ordre>:<élément>" (un remplacement par ordre et par élément) ou "manual:<id>".
  dedupeKey       String    @unique
  vehicleId       String
  itemId          String
  workOrderId     String?
  /// "PART", "PACKAGE", "KEYWORD" ou "MANUAL".
  source          String
  matchedText     String?
  doneAt          DateTime
  km              Int?
  /// Montant TTC des lignes reconnues (millimes) : « dernier prix facturé ».
  amountTtc       Int?
  correctedDoneAt DateTime?
  correctedKm     Int?
  cancelledAt     DateTime?
  cancelReason    String?
  correctedById   String?
  correctedAt     DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  item    MaintenanceItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([vehicleId, itemId])
  @@index([itemId])
  @@index([workOrderId])
}

/// Prévision (ESTIMATION) véhicule × élément. Historisée : un résultat différent crée une nouvelle
/// version (isCurrent) ; l'ancienne est gardée telle quelle. Statut : PROPOSED → VALIDATED → SENT →
/// BOOKED → DONE, ou IGNORED (+ motif).
model MaintenanceForecast {
  id              String    @id @default(cuid())
  vehicleId       String
  itemId          String
  version         Int
  isCurrent       Boolean   @default(true)
  previousId      String?
  /// "HISTORY_MODEL", "REFERENCE" ou "IMPOSSIBLE".
  method          String
  cases           Int       @default(0)
  /// "LOW", "MEDIUM", "GOOD" (null = estimation impossible).
  confidence      String?
  /// Ce qui manque quand l'estimation est impossible (clés : lastReplacement, interval, currentKm, rhythm).
  missing         Json      @default("[]")
  lastEventId     String?
  lastDoneAt      DateTime?
  lastDoneKm      Int?
  kmPerMonth      Int?
  dueKm           Int?
  dueKmLow        Int?
  dueKmHigh       Int?
  /// Échéance par le kilométrage convertie en date (rythme connu) et échéance par le temps.
  dueByKmDate     DateTime?
  dueByTimeDate   DateTime?
  /// Échéance retenue (la plus proche des deux) et sa fourchette.
  dueDate         DateTime?
  dueDateLow      DateTime?
  dueDateHigh     DateTime?
  /// Détails du calcul (groupe de modèles utilisé, quartiles, intervalle de référence…).
  explain         Json      @default("{}")
  priceTtc        Int?
  /// "PACKAGE" ou "LAST_INVOICED".
  priceSource     String?
  warrantyUntil   DateTime?
  warrantyLabel   String?
  /// Empreinte du résultat : recalcul identique = aucune écriture.
  signature       String
  /// "PROPOSED", "VALIDATED", "SENT", "BOOKED", "DONE" ou "IGNORED".
  status          String    @default("PROPOSED")
  statusReason    String?
  validatedAt     DateTime?
  validatedById   String?
  sentAt          DateTime?
  bookedAt        DateTime?
  appointmentId   String?
  doneAt          DateTime?
  doneWorkOrderId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  item    MaintenanceItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, itemId, version])
  @@index([isCurrent, dueDate])
  @@index([vehicleId, isCurrent])
  @@index([status])
}

/// Historique des messages aux clients (rappels). Une ligne par canal ; dedupeKey
/// empêche d'envoyer deux fois le même rappel. Jamais simulé : SKIPPED dit pourquoi.
model Notification {
  id            String    @id @default(cuid())
  /// "MAINTENANCE", "APPOINTMENT" ou "DELIVERY".
  kind          String
  /// "SMS", "EMAIL" ou "NONE" (aucun canal possible).
  channel       String
  dedupeKey     String
  customerId    String?
  vehicleId     String?
  workOrderId   String?
  appointmentId String?
  maintenanceId String?
  /// V12 — prévision de l'agenda à l'origine du message (kind "AGENDA").
  forecastId    String?
  to            String?
  subject       String?
  body          String
  /// "PENDING", "SENDING", "SENT", "FAILED" (réessayé) ou "SKIPPED".
  status        String    @default("PENDING")
  error         String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([dedupeKey, channel])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// ── V15 — File d'attente de l'accueil (borne, écran de salle, poste d'accueil) ──
// Bloc séparé (fusion facile). Pas de relation Prisma vers Customer / Vehicle / Appointment / WorkOrder /
// Invoice / User : de simples identifiants indexés, pour ne modifier aucun modèle existant.

/// V15 — réglages de la file d'attente (une seule ligne, id = "garage").
model QueueSetting {
  id                String   @id @default("garage")
  /// Temps d'attente estimé = moyenne réelle des N derniers tickets appelés de ce motif (fenêtre réglable).
  waitWindow        Int      @default(20)
  /// En dessous de ce nombre de tickets observés : « — » (pas d'estimation).
  waitMinTickets    Int      @default(3)
  /// RDV « à l'heure » : arrivé dans la fenêtre ± N minutes autour de l'heure du RDV → servi en premier.
  apptWindowMin     Int      @default(15)
  /// Motifs « rapides » (paiement, récupération) prioritaires après les RDV.
  fastFirst         Boolean  @default(false)
  /// Appels sans réponse avant « absent », et délai entre deux appels (secondes).
  maxCalls          Int      @default(3)
  callTimeoutSec    Int      @default(60)
  /// Message « encore N personnes avant vous » quand il reste N personnes ou moins (0 = jamais).
  aheadThreshold    Int      @default(2)
  /// Écran de salle : "ALTERNATE" (fr puis ar) ou "SIDE" (côte à côte) ; thème "DARK" ou "LIGHT".
  screenLangMode    String   @default("ALTERNATE")
  screenTheme       String   @default("DARK")
  /// Écran de salle : plaque masquée (« 215 TU 12** ») à côté du numéro. Désactivé par défaut.
  screenMaskedPlate Boolean  @default(false)
  /// « À traiter » : client en attente depuis plus de N minutes.
  waitAlertMin      Int      @default(20)
  /// Imprimante de tickets réseau ESC/POS (facultative) : adresse IP et port (9100 en général).
  printerHost       String?
  printerPort       Int      @default(9100)
  updatedAt         DateTime @updatedAt
}

/// V15 — motifs de visite (catalogue fr/ar/en, préfixe du numéro : A, B…).
model QueueReason {
  id        String   @id @default(cuid())
  code      String   @unique
  /// Lettre(s) du numéro de ticket, ex. "A" → A-12.
  prefix    String
  nameFr    String
  nameAr    String?
  nameEn    String?
  /// "DROP_OFF" (dépôt), "PICKUP" (récupération), "QUOTE" (devis / question), "PAYMENT" (paiement) ou "OTHER".
  kind      String   @default("OTHER")
  /// Motif rapide (prioritaire si QueueSetting.fastFirst).
  fast      Boolean  @default(false)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// V15 — guichets (Guichet 1, Caisse…) et l'employé qui y est connecté.
model QueueCounter {
  id        String    @id @default(cuid())
  name      String
  nameAr    String?
  isActive  Boolean   @default(true)
  position  Int       @default(0)
  userId    String?
  userSince DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// V15 — ticket de la file d'attente. Jamais supprimé (absent / annulé restent dans l'historique).
model QueueTicket {
  id            String    @id @default(cuid())
  /// Jour du garage "AAAA-MM-JJ" : la numérotation repart à 1 chaque jour (par préfixe).
  day           String
  prefix        String
  number        Int
  reasonId      String
  reasonKind    String
  /// Immatriculation normalisée (facultative). Jamais affichée en entier sur l'écran public.
  plate         String?
  vehicleId     String?
  customerId    String?
  appointmentId String?
  /// Heure du RDV reconnu (priorité « RDV à l'heure »).
  apptAt        DateTime?
  workOrderId   String?
  /// "WAITING", "CALLED", "SERVING", "DONE", "ABSENT" ou "CANCELLED".
  status        String    @default("WAITING")
  /// Priorité manuelle (0 = normale, 1 = passée devant par l'accueil).
  priority      Int       @default(0)
  callCount     Int       @default(0)
  counterId     String?
  userId        String?
  /// "KIOSK" (borne) ou "DESK" (poste d'accueil).
  source        String    @default("KIOSK")
  deviceId      String?
  /// Langue choisie à la borne ("fr" / "ar" / "en") pour les messages.
  lang          String    @default("fr")
  /// Téléphone pour le SMS « c'est votre tour » : seulement avec le consentement du client.
  phone         String?
  notifyConsent Boolean   @default(false)
  consentAt     DateTime?
  aheadNotified Boolean   @default(false)
  /// Jeton du lien de suivi public du ticket (aucune donnée personnelle sur cette page).
  trackToken    String    @unique
  cancelReason  String?
  takenAt       DateTime  @default(now())
  calledAt      DateTime?
  servingAt     DateTime?
  doneAt        DateTime?
  absentAt      DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([day, prefix, number])
  @@index([day, status])
  @@index([status, takenAt])
  @@index([reasonId, calledAt])
}

/// V15 — appareils de l'accueil (tablette de la borne, TV de la salle), sans compte : jeton d'appareil
/// créé par l'administrateur. Seule l'empreinte SHA-256 du jeton est gardée (le jeton n'est montré qu'une fois).
model QueueDevice {
  id          String    @id @default(cuid())
  name        String
  /// "KIOSK" (borne d'entrée) ou "SCREEN" (écran de salle).
  kind        String
  tokenHash   String    @unique
  createdById String?
  revokedAt   DateTime?
  revokedById String?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Suivi d'une alerte de la page « Suivi & retards » : assignée, traitée, reportée.
/// La clé contient la date concernée : si la situation change (nouvelle date promise…),
/// c'est une nouvelle alerte.
model AlertState {
  key          String    @id
  assignedToId String?
  handledAt    DateTime?
  handledById  String?
  snoozedUntil DateTime?
  note         String?
  updatedAt    DateTime  @updatedAt
}

/// Relevé OBD-II d'un véhicule. "source" dit d'où vient chaque donnée : ADAPTER (lu sur la
/// voiture) ou SIMULATED (démonstration — jamais utilisé pour le kilométrage ni les rappels).
/// Ce que la voiture ne fournit pas est listé dans "unsupported", jamais estimé.
model VehicleReading {
  id             String   @id @default(cuid())
  vehicleId      String
  workOrderId    String?
  /// "ADAPTER" ou "SIMULATED".
  source         String
  adapter        String?
  protocol       String?
  vin            String?
  odometerKm     Int?
  /// "APPLIED" (kilométrage du véhicule mis à jour, confirmé), "NOT_APPLIED", "LOWER" (inférieur au
  /// dernier relevé : signalé, jamais appliqué), "UNSUPPORTED" (la voiture ne le fournit pas), "SIMULATED".
  odometerStatus String
  /// [{ code: "P0133", kind: "stored" | "pending" | "permanent" }]
  dtcs           Json     @default("[]")
  /// [{ pid, name, value, unit }]
  live           Json     @default("[]")
  unsupported    Json     @default("[]")
  warnings       Json     @default("[]")
  note           String?
  recordedById   String?
  recordedAt     DateTime @default(now())

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@index([workOrderId])
}

// ── Garanties (V8.4) ─────────────────────────────────────────────────────────

/// Garantie sur une réparation ("REPAIR", donnée par le garage au client) ou sur une pièce
/// ("PART", donnée par le fournisseur). Valable jusqu'à endsAt et/ou endKm : la première limite
/// atteinte l'emporte. Jamais effacée : une erreur est annulée (voidedAt + motif).
model Warranty {
  id              String    @id @default(cuid())
  /// "REPAIR" ou "PART".
  kind            String
  workOrderId     String?
  vehicleId       String
  customerId      String
  supplierId      String?
  partId          String?
  /// Ligne de l'ordre concernée (pièce), sans clé étrangère : la ligne peut être retirée de l'ordre.
  workOrderLineId String?
  /// Ce qui est couvert, ex. « Embrayage complet ».
  label           String
  startsAt        DateTime
  endsAt          DateTime?
  startKm         Int?
  endKm           Int?
  terms           String?
  /// Garantie automatique créée à la livraison : = workOrderId (une seule par ordre). null = saisie à la main.
  autoWorkOrderId String?   @unique
  createdById     String?
  createdAt       DateTime  @default(now())
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?

  workOrder WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer  Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  part      Part?           @relation(fields: [partId], references: [id], onDelete: SetNull)
  claims    WarrantyClaim[]

  @@index([vehicleId])
  @@index([workOrderId])
  @@index([endsAt])
}

/// Réclamation sous garantie. Statut : OPEN → SUBMITTED → ACCEPTED | PARTIAL | REJECTED → CLOSED
/// (OPEN → CLOSED si abandonnée). Montants en millimes, visibles des responsables seulement.
model WarrantyClaim {
  id             String    @id @default(cuid())
  /// Affiché "GAR-0007".
  number         Int       @unique @default(autoincrement())
  warrantyId     String
  openedAt       DateTime  @default(now())
  openedById     String?
  description    String
  /// "OPEN", "SUBMITTED", "ACCEPTED", "PARTIAL", "REJECTED" ou "CLOSED".
  status         String    @default("OPEN")
  submittedAt    DateTime?
  /// Réponse du fournisseur / décision du garage (texte).
  decision       String?
  decidedAt      DateTime?
  decidedById    String?
  closedAt       DateTime?
  /// Coût de la reprise pour le garage (pièces, main-d'œuvre).
  costParts      Int       @default(0)
  costLabor      Int       @default(0)
  amountClaimed  Int       @default(0)
  /// null = pas encore de décision ; 0 si refusée.
  amountAccepted Int?
  updatedAt      DateTime  @updatedAt

  warranty Warranty         @relation(fields: [warrantyId], references: [id], onDelete: Restrict)
  refunds  WarrantyRefund[]

  @@index([warrantyId])
  @@index([status])
}

/// Remboursement reçu pour une réclamation acceptée (argent réellement encaissé).
model WarrantyRefund {
  id          String        @id @default(cuid())
  claimId     String
  amount      Int
  receivedAt  DateTime
  method      PaymentMethod
  reference   String?
  createdById String?
  createdAt   DateTime      @default(now())
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?

  claim WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@index([claimId])
  @@index([receivedAt])
}

// ── Contrats (V9.0) ──────────────────────────────────────────────────────────

/// Modèle de contrat versionné (Tunisie), copié depuis le catalogue du code (src/lib/contract-templates.ts)
/// avec un id déterministe "tpl-<code>-v<version>" (la même ligne sur le PC du garage et en ligne).
/// Jamais « conforme » : "NEEDS_LEGAL_REVIEW" tant qu'un administrateur n'a pas enregistré la relecture
/// d'un juriste pour CETTE version (reviewedById / reviewedAt, journalisé).
model ContractTemplate {
  id           String    @id
  code         String
  /// "REPAIR", "FLEET", "EMPLOYMENT", "SUPPLIER" ou "BLANK".
  category     String
  /// Métier (emploi) ou type de partenaire (fournisseur), ex. "MECHANIC", "PARTS".
  subtype      String?
  title        String
  version      Int
  jurisdiction String    @default("TN")
  /// [{ ref, subject, confidence }] — uniquement les références vérifiées (docs/CONTRATS.md).
  legalRefs    Json      @default("[]")
  /// Points non vérifiés, à faire valider par un juriste tunisien.
  unverified   Json      @default("[]")
  verifiedAt   DateTime  @db.Date
  /// "NEEDS_LEGAL_REVIEW" (défaut) ou "REVIEWED".
  reviewStatus String    @default("NEEDS_LEGAL_REVIEW")
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  /// [{ key, type, required, options?, default?, showIf? }]
  fields       Json      @default("[]")
  /// [{ key, title, body, required, showIf? }]
  clauses      Json      @default("[]")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contracts Contract[]

  @@unique([code, version])
  @@index([category])
}

/// Contrat "CTR-2026-0001". Statut : DRAFT → VALIDATION → LEGAL_REVIEW → APPROVED → PENDING_SIGNATURE →
/// SIGNED (scan signé déposé) → ACTIVE → EXPIRED | TERMINATED → ARCHIVED. Jamais supprimé, jamais
/// renouvelé automatiquement (renouvellement = nouveau contrat lié, avec son fondement).
model Contract {
  id                 String    @id @default(cuid())
  number             String    @unique
  templateId         String
  templateVersion    Int
  category           String
  subtype            String?
  title              String
  status             String    @default("DRAFT")
  customerId         String?
  workOrderId        String?
  /// Employé (contrat de travail).
  userId             String?
  supplierId         String?
  startDate          DateTime  @db.Date
  /// Dernier jour inclus ; null = pas de fin (CDI, réparation).
  endDate            DateTime? @db.Date
  durationMonths     Int?
  /// Durée indéterminée (CDI) : jamais de date de fin.
  indefinite         Boolean   @default(false)
  /// { fields: {clé: texte}, snapshot: {garage, party, vehicles, repair?}, excluded: [clauses facultatives retirées] }
  data               Json      @default("{}")
  /// ["TEMPLATE_NOT_REVIEWED", "CDD", "DISGUISED_EMPLOYMENT_RISK", "RENEWAL"] : revue juridique requise.
  flags              Json      @default("[]")
  previousContractId String?
  /// Fondement écrit du renouvellement (obligatoire pour un contrat de renouvellement).
  renewalBasis       String?
  /// Scan du contrat signé à la main (stockage privé, servi par /api/contracts/[id]/scan).
  signedScanKey      String?
  signedScanType     String?
  signedScanSize     Int?
  signedAt           DateTime?
  terminatedAt       DateTime?
  terminationReason  String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  template  ContractTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  customer  Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  workOrder WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  user      User?             @relation("ContractEmployee", fields: [userId], references: [id], onDelete: Restrict)
  supplier  Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  previous  Contract?         @relation("ContractRenewal", fields: [previousContractId], references: [id], onDelete: SetNull)
  renewals  Contract[]        @relation("ContractRenewal")
  vehicles  ContractVehicle[]
  events    ContractEvent[]

  @@index([category, status])
  @@index([endDate])
  @@index([customerId])
  @@index([workOrderId])
  @@index([userId])
  @@index([supplierId])
}

/// Véhicule(s) couvert(s) par un contrat (réparation : 1 ; flotte : plusieurs).
model ContractVehicle {
  id         String @id @default(cuid())
  contractId String
  vehicleId  String

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([contractId, vehicleId])
  @@index([vehicleId])
}

/// Historique d'un contrat : chaque changement, qui, quand, avant / après. Jamais modifié.
model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  actorId    String?
  actorName  String
  /// "CREATED", "UPDATED", "STATUS", "SCAN", "RENEWED", "REFRESHED".
  type       String
  fromStatus String?
  toStatus   String?
  before     Json?
  after      Json?
  note       String?
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([contractId, createdAt])
}

// ── Dépenses et échéances, trésorerie (V8.4) ─────────────────────────────────

/// Charge fixe ou ponctuelle (loyer, salaires, électricité, crédit…). Les échéances sont créées
/// au fur et à mesure (ExpenseOccurrence), jusqu'à l'horizon de la prévision.
model RecurringExpense {
  id           String    @id @default(cuid())
  label        String
  /// "RENT", "SALARY", "UTILITIES", "LOAN", "TAX", "INSURANCE" ou "OTHER".
  category     String
  /// Montant de chaque échéance (millimes TTC).
  amount       Int
  /// "ONCE", "MONTHLY", "QUARTERLY" ou "YEARLY".
  frequency    String
  firstDueDate DateTime  @db.Date
  /// Dernière échéance possible (incluse). null = sans fin.
  endDate      DateTime? @db.Date
  supplierId   String?
  /// false = arrêtée : ses échéances non payées ne sont plus prévues.
  active       Boolean   @default(true)
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  occurrences ExpenseOccurrence[]
}

/// Une échéance d'une charge. Une seule par charge et par date (création idempotente).
/// Payée = soldée (paidAmount = ce qui a vraiment été payé).
model ExpenseOccurrence {
  id         String         @id @default(cuid())
  expenseId  String
  dueDate    DateTime       @db.Date
  amount     Int
  paidAt     DateTime?
  paidAmount Int?
  method     PaymentMethod?
  reference  String?
  paidById   String?
  createdAt  DateTime       @default(now())

  expense RecurringExpense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([expenseId, dueDate])
  @@index([dueDate])
}

/// Solde caisse + banque saisi à la main, en fin de journée du asOf. Historique conservé :
/// la prévision part du plus récent.
model CashBalance {
  id          String   @id @default(cuid())
  /// Millimes (négatif possible : découvert).
  amount      Int
  asOf        DateTime @db.Date
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([asOf(sort: Desc), createdAt(sort: Desc)])
}

// ── Showroom (V9, Prompt 5/5) ────────────────────────────────────────────────
// Aucun modèle existant n'est modifié : vehicleId, sellerId, createdById, actorId sont de simples
// identifiants (sans relation Prisma), contrôlés par le code (src/server/showroom.ts).

/// Annonce d'un véhicule à vendre. Statut (texte) : DRAFT, PUBLISHED, RESERVED, SOLD, UNAVAILABLE, ARCHIVED
/// (passages autorisés : src/lib/showroom.ts). Publique : PUBLISHED et RESERVED ; SOLD affichée « Vendu »
/// 14 jours puis masquée. Jamais effacée : archivée. Prix en millimes TTC.
model Listing {
  id              String    @id @default(cuid())
  /// Affiché "ANN-0007" ; l'adresse publique finit par ce numéro (/showroom/peugeot-208-2019-7).
  number          Int       @unique @default(autoincrement())
  /// Véhicule déjà connu de l'atelier (évite les doublons ; permet le kilométrage vérifié).
  vehicleId       String?
  /// Interne, jamais publié.
  plate           String?
  vin             String?
  make            String
  model           String
  version         String?
  year            Int?
  mileage         Int?
  /// "ESSENCE", "DIESEL", "HYBRID", "ELECTRIC" ou "GPL".
  fuel            String?
  /// "MANUAL" ou "AUTOMATIC".
  gearbox         String?
  engineCc        Int?
  powerHp         Int?
  fiscalHp        Int?
  doors           Int?
  seats           Int?
  colorExt        String?
  colorInt        String?
  /// "NEW", "EXCELLENT", "GOOD", "FAIR" ou "TO_REPAIR".
  condition       String?
  /// null = prix non fixé (publication impossible).
  price           Int?
  description     String?
  /// ["Climatisation", "Caméra de recul", …]
  equipment       Json      @default("[]")
  /// [{ "label": "Couple", "value": "250 Nm" }, …]
  specs           Json      @default("[]")
  /// Source de chaque fait affiché, calculée par le serveur (jamais saisie) :
  /// { "mileage": { "source": "GARAGE" | "SELLER", "ref": "OR-0042", "at": "2026-10-01" }, … }
  facts           Json      @default("{}")
  /// Résumé de l'historique d'atelier, rédigé et relu par l'équipe (sans nom de client).
  historySummary  String?
  /// Le résumé n'est publié que si l'équipe l'a explicitement décidé.
  historyPublic   Boolean   @default(false)
  status          String    @default("DRAFT")
  sellerId        String
  createdById     String?
  publishedAt     DateTime?
  soldAt          DateTime?
  statusChangedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  media         ListingMedia[]
  events        ListingEvent[]
  conversations Conversation[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([sellerId])
  @@index([vehicleId])
  @@index([make])
}

/// Photo (JPEG, PNG, WEBP) ou document (PDF) d'une annonce, dans le stockage existant (src/server/storage.ts).
model ListingMedia {
  id           String   @id @default(cuid())
  listingId    String
  /// "PHOTO" ou "DOCUMENT".
  kind         String
  storageKey   String   @unique
  contentType  String
  size         Int
  caption      String?
  position     Int      @default(0)
  isCover      Boolean  @default(false)
  /// Visible sur le site. Photos : oui par défaut ; documents : non par défaut (une carte grise
  /// contient des données personnelles) — l'équipe décide document par document.
  isPublic     Boolean  @default(true)
  uploadedById String?
  createdAt    DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

/// Historique d'une annonce : CREATED, UPDATED, PRICE_CHANGED, MILEAGE_CHANGED, STATUS_CHANGED, SELLER_CHANGED,
/// PHOTO_ADDED, DOCUMENT_ADDED, MEDIA_REMOVED (avant → après, qui, quand). Jamais modifié.
model ListingEvent {
  id        String   @id @default(cuid())
  listingId String
  type      String
  before    Json?
  after     Json?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
}

// ── Messagerie acheteurs (V9, Prompt 5/5) ────────────────────────────────────

/// Conversation entre un acheteur (sans compte) et le garage au sujet d'une annonce. L'acheteur
/// n'y accède que par son lien privé /messages/<jeton> ; seul le hachage du jeton est stocké.
/// workOrderId : prévu pour lier une conversation à une réparation (non utilisé en V9).
/// assignedToId : membre de l'équipe en charge (simple identifiant, comme sellerId).
model Conversation {
  id             String   @id @default(cuid())
  listingId      String?
  workOrderId    String?
  buyerName      String
  buyerPhone     String?
  buyerEmail     String?
  /// SHA-256 (hexadécimal) du jeton du lien privé. Le jeton lui-même n'est jamais enregistré.
  buyerTokenHash String   @unique
  assignedToId   String?
  /// "OPEN" ou "CLOSED".
  status         String   @default("OPEN")
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  messages Message[]

  @@index([listingId, lastMessageAt(sort: Desc)])
  @@index([assignedToId, lastMessageAt(sort: Desc)])
  @@index([lastMessageAt(sort: Desc)])
}

/// Message d'une conversation. Texte brut limité à 2 000 caractères (affiché échappé).
/// readByStaffAt : message d'acheteur lu par l'équipe ; readByBuyerAt : message de l'équipe lu par l'acheteur.
model Message {
  id             String    @id @default(cuid())
  conversationId String
  /// "STAFF" ou "BUYER".
  authorKind     String
  authorUserId   String?
  /// Nom du membre de l'équipe au moment de l'envoi.
  authorName     String?
  body           String
  createdAt      DateTime  @default(now())
  readByStaffAt  DateTime?
  readByBuyerAt  DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([authorKind, readByStaffAt])
}

// ── Carte des compétences (V14) ──────────────────────────────────────────────

/// Compétence du catalogue (id déterministe "sk_<code>" : la même ligne sur le PC du garage et en ligne).
/// Demandée par les forfaits liés (packageIds) et les mots-clés des lignes d'un ordre.
model Skill {
  id                   String   @id
  code                 String   @unique
  nameFr               String
  nameAr               String?
  nameEn               String?
  description          String?
  /// Mots-clés (mot entier, sans accents) cherchés dans les lignes et la demande du client.
  keywords             Json     @default("[]")
  packageIds           Json     @default("[]")
  /// Un SUPERVISÉ ne travaille pas seul : avertissement s'il n'a pas de superviseur AUTONOME.
  supervisionRequired  Boolean  @default(false)
  /// Habilitation exigée (ex. haute tension) : affectation REFUSÉE sans certificat valide, sauf dérogation.
  habilitationRequired Boolean  @default(false)
  /// Libellé public choisi par le garage (suivi client), ex. « technicien certifié climatisation ».
  publicLabelFr        String?
  publicLabelAr        String?
  publicLabelEn        String?
  isActive             Boolean  @default(true)
  position             Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  levels       EmployeeSkill[]
  history      SkillLevelHistory[]
  certificates SkillCertificate[]
  goals        SkillGoal[]
  reviews      SkillReviewRequest[]
}

/// Niveau actuel d'un employé : "AUTONOMOUS", "SUPERVISED", "TRAINING" ou "NOT_CONCERNED".
/// Toujours décidé par un responsable / administrateur (jamais calculé). id déterministe "es_<hash>".
model EmployeeSkill {
  id          String   @id
  userId      String
  skillId     String
  level       String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([skillId, level])
}

/// Historique des niveaux (qui, quand, ancien → nouveau, motif). Jamais modifié (trigger SQL).
model SkillLevelHistory {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  fromLevel String?
  toLevel   String
  reason    String
  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([skillId])
}

/// Certificat / habilitation d'un employé (fichier dans le stockage privé, servi après contrôle d'accès).
/// Expiré → la compétence liée est « à vérifier » (indicateur), le niveau ne change pas.
model SkillCertificate {
  id          String    @id @default(cuid())
  userId      String
  skillId     String?
  type        String
  issuer      String?
  issuedOn    DateTime? @db.Date
  expiresOn   DateTime? @db.Date
  fileKey     String?
  fileType    String?
  fileSize    Int?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresOn])
}

/// Objectif de progression (SUIVI) : "SUPERVISED_NO_RETURN" (travaux supervisés sans retour garantie)
/// ou "JOBS_NO_RETURN" (travaux sans retour). Atteint → « à réévaluer », jamais de changement de niveau.
model SkillGoal {
  id          String    @id @default(cuid())
  userId      String
  skillId     String
  kind        String
  target      Int
  since       DateTime
  note        String?
  /// "ACTIVE", "REACHED" ou "CLOSED".
  status      String    @default("ACTIVE")
  reachedAt   DateTime?
  closedAt    DateTime?
  closedById  String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

/// Demande de réévaluation : "EMPLOYEE" (message de l'intéressé) ou "GOAL" (objectif atteint, id "sr_goal_<objectif>").
model SkillReviewRequest {
  id          String    @id @default(cuid())
  userId      String
  skillId     String?
  goalId      String?
  source      String
  message     String?
  /// "OPEN" ou "DONE".
  status      String    @default("OPEN")
  handledAt   DateTime?
  handledById String?
  handledNote String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}
